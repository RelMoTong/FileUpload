{
  "include": [
    "src/models",
    "src/controllers",
    "src/repositories",
    "src/core",
    "src/config.py",
    "src/services/auth_service.py",
    "src/services/ftp_service.py",
    "src/services/runtime_service.py",
    "src/services/upload_service.py",
    "src/workers/upload_worker.py",
    "src/protocols/ftp.py"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/dist",
    "**/build"
  ],
  "ignore": [],
  "defineConstant": {},
